# Environment Configuration Template for Quant Sticky Note
# 
# Copy this file to .env and fill in values for your environment.
# IMPORTANT: Never commit .env to version control (it's in .gitignore)
#
# Format: VARIABLE_NAME=value
# Notes:
# - Strings don't need quotes (but can have them)
# - Don't use spaces around the = sign
# - Lines starting with # are comments
# - Empty values use default if specified

# ==============================================================================
# SERVICE CONFIGURATION
# ==============================================================================

# Service identifier for logging and monitoring
SERVICE_NAME=quant_stickynote

# Deployment environment (development, staging, production)
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# DEBUG: Most verbose, includes all debug info
# INFO: Normal operation, events and milestones
# WARNING: Only warnings and errors
# ERROR: Only errors
LOG_LEVEL=INFO

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PostgreSQL connection string for local sticky note storage
# Format: postgresql://username:password@hostname:port/database_name
# 
# Examples:
#   postgresql://user:pass@localhost:5432/quant_stickynote          (local)
#   postgresql://user:pass@db.example.com:5432/quant_stickynote     (remote)
#   postgresql://postgres:postgres@postgres-service:5432/quant      (Docker)
#
# For development with docker-compose, use:
#   postgresql://postgres:postgres@postgres:5432/quant_stickynote
#
# WARNING: Use environment variables for passwords in production!
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quant_stickynote

# Optional: Database connection pool settings
# Uncomment to override defaults (usually not needed)
# DATABASE_POOL_SIZE=10
# DATABASE_POOL_RECYCLE_SECONDS=3600
# DATABASE_POOL_PRE_PING=true

# ==============================================================================
# SCHEDULING CONFIGURATION
# ==============================================================================

# Time to trigger query execution (UTC, HH:MM format)
# Examples:
#   09:30    - 9:30 AM UTC (typical US market open)
#   14:00    - 2:00 PM UTC
#   00:00    - Midnight UTC (for end-of-day batch)
TRIGGER_TIME=09:30

# How often to check if it's time to run (seconds)
# Lower values (e.g., 30) = more responsive but higher CPU
# Higher values (e.g., 300) = less responsive but lower CPU
# Recommended: 60 for normal use, 300 for very low-resource environments
CHECK_INTERVAL_SECONDS=60

# ==============================================================================
# API SERVER CONFIGURATION
# ==============================================================================

# Host to bind API server to
# 0.0.0.0    = Listen on all interfaces (production)
# 127.0.0.1  = Listen only on localhost (development)
# localhost  = Listen only on localhost (alternative)
API_HOST=0.0.0.0

# Port for REST API
# Common ports: 8000, 8080, 8000, 5000
# Note: Ports below 1024 require root/admin privileges
API_PORT=8080

# Number of worker threads for API server (Waitress)
# Recommended: 20 for typical workloads
# Increase for high-concurrency scenarios
# Decrease for resource-constrained environments
API_WORKERS=20

# ==============================================================================
# WORKER DAEMON CONFIGURATION
# ==============================================================================

# Enable the background worker that executes queries
# true   = Worker runs (typical for production)
# false  = API-only mode (useful for debugging or scaling)
WORKER_ENABLED=true

# How often to log worker cycle status (every N cycles)
# Higher values = less logging noise
# Recommended: 10 (logs every 10 minutes if CHECK_INTERVAL=60)
WORKER_LOG_EVERY_N_CYCLES=10

# ==============================================================================
# EXTERNAL DATABASE CONNECTIONS
# ==============================================================================

# These are used by query definitions in queries/ directory
# Define any external databases your queries need to connect to
#
# Pattern: <SOURCE_NAME>_DATABASE_URL=postgresql://...
#
# Then reference in query JSON using:
#   "external_database": {
#     "url": "${<SOURCE_NAME>_DATABASE_URL}"
#   }
#
# Examples below (uncomment and fill in as needed):

# Data warehouse with technical indicators
# DATA_WAREHOUSE_URL=postgresql://user:password@data-warehouse.example.com:5432/market_analysis

# Options and volatility data
# OPTIONS_ANALYSIS_URL=postgresql://user:password@options-db.example.com:5432/options_data

# Historical price data
# HISTORICAL_DATA_URL=postgresql://user:password@history-db.example.com:5432/price_history

# Insider trading data
# INSIDER_DATA_URL=postgresql://user:password@insider-db.example.com:5432/insider_data

# ==============================================================================
# OPTIONAL: ALERTING & NOTIFICATIONS
# ==============================================================================

# Email alerts when signals are generated (future feature)
# ALERT_ENABLED=false
# ALERT_EMAIL=trader@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Slack webhook for notifications (future feature)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==============================================================================
# OPTIONAL: REDIS CACHING (future feature)
# ==============================================================================

# Enable Redis caching of query results
# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379/0
# REDIS_CACHE_TTL_SECONDS=3600

# ==============================================================================
# OPTIONAL: MONITORING & OBSERVABILITY
# ==============================================================================

# Prometheus metrics endpoint
# PROMETHEUS_ENABLED=false
# PROMETHEUS_PORT=9090

# Datadog APM (if using Datadog monitoring)
# DATADOG_ENABLED=false
# DATADOG_API_KEY=
# DATADOG_ENVIRONMENT=development

# ==============================================================================
# DEVELOPMENT ONLY
# ==============================================================================

# Enable debug mode (more verbose output, stack traces)
# Only set to true during development
# DEBUG=false

# Reload code on file changes (requires watchdog package)
# RELOAD_ON_CHANGES=false

# ==============================================================================
# NOTES FOR DEPLOYMENT
# ==============================================================================

# Production Deployment:
#   1. Use environment variables for all sensitive data (passwords, API keys)
#   2. Set ENVIRONMENT=production
#   3. Set LOG_LEVEL=WARNING (less noise)
#   4. Use managed PostgreSQL service (AWS RDS, Azure Database, etc.)
#   5. Use supervisord for process management
#   6. Run behind a reverse proxy (nginx, HAProxy) with SSL
#
# Docker Deployment:
#   1. Use docker-compose with .env file
#   2. Define DATABASE_URL for postgres service
#   3. Set external database URLs for your data sources
#   4. Use docker secrets for sensitive values (production)
#
# Development Setup:
#   1. Copy this file to .env
#   2. Fill in local values (usually localhost)
#   3. Run: docker-compose -f docker-compose.dev.yml up -d
#   4. Set DATABASE_URL to the Docker postgres container
