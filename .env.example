# Environment Variables for Quant Sticky Note Service
# Copy this to .env and fill in actual values

# REQUIRED: PostgreSQL connection string to external data warehouse
# Format: postgresql://user:password@host:5432/database_name
DATABASE_URL=postgresql://user:password@localhost:5432/datawarehouse

# OPTIONAL: UTC time to execute scheduled queries (HH:MM format)
# Default: 09:30
TRIGGER_TIME=09:30

# OPTIONAL: Worker polling interval in seconds
# Default: 60 (poll every minute to check if TRIGGER_TIME reached)
CHECK_INTERVAL_SECONDS=60

# OPTIONAL: Logging level - DEBUG, INFO, WARNING, ERROR
# Default: INFO
LOG_LEVEL=INFO
