# Development environment configuration
SERVICE_NAME=quant_stickynote
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local PostgreSQL (or docker-compose postgres service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quant_stickynote

# Trigger configuration
TRIGGER_TIME=09:30
CHECK_INTERVAL_SECONDS=60

# API configuration
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4

# Worker configuration
WORKER_ENABLED=true
WORKER_LOG_EVERY_N_CYCLES=10

# Development options
DEBUG=false
RELOAD_ON_CHANGES=false
